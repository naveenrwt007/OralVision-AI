# ==========================
# Application
# ==========================
API_TITLE=OralVision AI API
API_VERSION=1.0.0

# ==========================
# Frontend
# ==========================
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================
# Image Validation
# ==========================
MIN_IMAGE_PIXELS=307200
MAX_IMAGE_PIXELS=16000000

# ==========================
# MongoDB
# ==========================
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
DATABASE_NAME=oralscan_ai

# ==========================
# JWT
# ==========================
JWT_SECRET_KEY=your-super-secret-jwt-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================
# Reports
# ==========================
REPORT_BASE_URL=http://127.0.0.1:8000
